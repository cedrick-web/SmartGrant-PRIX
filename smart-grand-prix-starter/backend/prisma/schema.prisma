generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum BusinessStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OpportunityType {
  JOB
  INTERNSHIP
  TRAINING
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum CredentialStatus {
  PENDING
  ISSUED
  REVOKED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique @db.VarChar(191)
  passwordHash    String           @db.VarChar(255)
  fullName        String           @db.VarChar(160)
  phone           String?          @db.VarChar(40)
  status          UserStatus       @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  businessMembers BusinessMember[]
  enquiries       Enquiry[]        @relation("EnquirySender")
  applications    Application[]
  professionalProfile ProfessionalProfile?
  auditLogs       AuditLog[]       @relation("AuditActor")
}

model Role {
  id        String     @id @default(cuid())
  name      String     @unique @db.VarChar(60)
  createdAt DateTime   @default(now())
  userRoles UserRole[]
}

model UserRole {
  userId    String
  roleId    String
  assignedAt DateTime @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Business {
  id              String           @id @default(cuid())
  name            String           @db.VarChar(180)
  slug            String           @unique @db.VarChar(191)
  description     String           @db.Text
  email           String?          @db.VarChar(191)
  phone           String?          @db.VarChar(40)
  website         String?          @db.VarChar(255)
  district        String?          @db.VarChar(100)
  status          BusinessStatus   @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  members         BusinessMember[]
  services        Service[]
  documents       BusinessDocument[]
  enquiries       Enquiry[]
  categoryLinks   BusinessCategoryLink[]
}

model BusinessMember {
  businessId String
  userId     String
  memberRole String   @default("OWNER") @db.VarChar(40)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([businessId, userId])
  @@index([userId])
}

model BusinessCategory {
  id        String     @id @default(cuid())
  name      String     @unique @db.VarChar(100)
  businesses BusinessCategoryLink[]
}

model BusinessCategoryLink {
  businessId String
  categoryId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
}

model BusinessDocument {
  id          String   @id @default(cuid())
  businessId  String
  storageKey  String   @db.VarChar(500)
  documentType String  @db.VarChar(80)
  uploadedAt  DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String   @db.VarChar(160)
  description String   @db.Text
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enquiries   Enquiry[]

  @@index([businessId, isPublished])
}

model Enquiry {
  id          String   @id @default(cuid())
  businessId  String
  serviceId   String?
  senderId    String?
  senderName  String   @db.VarChar(160)
  senderEmail String   @db.VarChar(191)
  message     String   @db.Text
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  sender      User?    @relation("EnquirySender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

model Opportunity {
  id          String             @id @default(cuid())
  title       String             @db.VarChar(180)
  description String             @db.Text
  type        OpportunityType
  status      OpportunityStatus  @default(DRAFT)
  organizationName String        @db.VarChar(180)
  location    String?            @db.VarChar(120)
  deadline    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  applications Application[]

  @@index([status, type, deadline])
}

model Application {
  id            String      @id @default(cuid())
  opportunityId String
  userId        String
  coverMessage  String?     @db.Text
  status        String      @default("SUBMITTED") @db.VarChar(40)
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
  @@index([userId, createdAt])
}

model ProfessionalProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  headline    String?  @db.VarChar(180)
  biography   String?  @db.Text
  skills      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials Credential[]
}

model Organization {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(180)
  description String?  @db.Text
  website     String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  articles    Article[]
  issuances   Credential[] @relation("CredentialIssuer")
}

model Article {
  id             String       @id @default(cuid())
  organizationId String?
  title          String       @db.VarChar(220)
  slug           String       @unique @db.VarChar(240)
  summary        String?      @db.Text
  body           String       @db.LongText
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sources        ArticleSource[]

  @@index([publishedAt])
}

model ArticleSource {
  id        String   @id @default(cuid())
  articleId String
  title     String   @db.VarChar(220)
  url       String   @db.VarChar(1000)
  publisher String?  @db.VarChar(160)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model Credential {
  id              String           @id @default(cuid())
  profileId       String
  issuerId        String
  title           String           @db.VarChar(180)
  issuedAt        DateTime
  expiresAt       DateTime?
  status          CredentialStatus @default(PENDING)
  privateFileKey  String?          @db.VarChar(500)
  createdAt       DateTime         @default(now())
  profile         ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  issuer          Organization     @relation("CredentialIssuer", fields: [issuerId], references: [id], onDelete: Restrict)
  proof           CredentialProof?

  @@index([issuerId, status])
}

model CredentialProof {
  id             String     @id @default(cuid())
  credentialId   String     @unique
  network        String     @db.VarChar(80)
  contractAddress String?   @db.VarChar(100)
  transactionHash String?   @db.VarChar(100)
  contentHash    String     @db.VarChar(128)
  anchoredAt     DateTime?
  credential     Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id                String        @id @default(cuid())
  provider          String        @db.VarChar(80)
  providerReference String?       @unique @db.VarChar(191)
  userId            String?
  amountMinor       BigInt
  currency          String        @db.VarChar(3)
  status            PaymentStatus @default(CREATED)
  idempotencyKey    String        @unique @db.VarChar(191)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model PaymentWebhook {
  id             String   @id @default(cuid())
  provider       String   @db.VarChar(80)
  providerEventId String  @unique @db.VarChar(191)
  payloadHash    String   @db.VarChar(128)
  processedAt    DateTime?
  receivedAt     DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(100)
  entityId   String   @db.VarChar(191)
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
